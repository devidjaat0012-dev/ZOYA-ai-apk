rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Hardened Global Primitives
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 3. Entity Validation Blueprints (Synchronized with firebase-blueprint.json)
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'photoURL', 'personaVibe', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'personaVibe', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.photoURL is string && data.photoURL.size() <= 1024
        && data.personaVibe is string && data.personaVibe in ['girlfriend', 'normal', 'serious', 'super_loyal']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidSavedMemory(data) {
      return data.keys().hasAll(['uid', 'fact', 'category', 'source', 'createdAt'])
        && data.keys().hasOnly(['uid', 'fact', 'category', 'source', 'createdAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() >= 1 && data.uid.size() <= 128 && data.uid.matches('^[a-zA-Z0-9_-]+$')
        && data.fact is string && data.fact.size() >= 1 && data.fact.size() <= 500
        && data.category is string && data.category in ['personal', 'preference', 'relationship', 'goal', 'work_study', 'important']
        && data.source is string && data.source in ['chat', 'live_voice', 'manual']
        && data.createdAt is timestamp;
    }

    // 4. User Profile Collection (/users/{userId}) - Strictly Owner-Isolated PII
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().updatedAt == request.time
        && (
          // Action: Update Profile & Persona Preference (supports idempotent setDoc or updateDoc)
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'personaVibe', 'createdAt', 'updatedAt'])
        );

      allow delete: if isOwner(userId) && isValidId(userId);

      // 5. User Memories Subcollection (/users/{userId}/memories/{memoryId})
      match /memories/{memoryId} {
        allow get: if isOwner(userId)
          && isValidId(userId)
          && isValidId(memoryId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow list: if isOwner(userId)
          && existing().uid == request.auth.uid;

        allow create: if isOwner(userId)
          && isValidId(userId)
          && isValidId(memoryId)
          && isValidSavedMemory(incoming())
          && incoming().createdAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow update: if isOwner(userId)
          && isValidId(userId)
          && isValidId(memoryId)
          && isValidSavedMemory(incoming())
          && incoming().uid == existing().uid
          && incoming().createdAt == request.time
          && (
            // Action: Sync or refresh memory item
            incoming().diff(existing()).affectedKeys().hasOnly(['fact', 'category', 'source', 'createdAt'])
          )
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;

        allow delete: if isOwner(userId)
          && isValidId(userId)
          && isValidId(memoryId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && get(/databases/$(database)/documents/users/$(userId)).data.uid == request.auth.uid;
      }
    }
  }
}
