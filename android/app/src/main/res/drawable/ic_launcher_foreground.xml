        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="30"
                android:startY="30"
                android:endX="78"
                android:endY="78"
                android:type="linear">
                <item android:offset="0" android:color="#EC4899" />
                <item android:offset="0.5" android:color="#8B5CF6" />
                <item android:offset="1" android:color="#06B6D4" />
            </gradient>
